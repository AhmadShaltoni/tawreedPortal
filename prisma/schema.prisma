// Prisma schema for Tawreed B2B Grocery Marketplace
// Platform: توريد - Curated Marketplace for Grocery Stores in Jordan

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User roles in the platform
enum UserRole {
  BUYER     // Grocery store owners (mobile app)
  SUPPLIER  // Wholesale distributors (managed by admin)
  ADMIN     // Platform administrators (dashboard)
}

// Status of a purchase request (RFQ) - Legacy
enum RequestStatus {
  OPEN
  IN_PROGRESS
  CLOSED
  CANCELLED
  EXPIRED
}

// Status of a supplier's offer - Legacy
enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
}

// Status of an order
enum OrderStatus {
  PENDING       // Order placed, awaiting admin confirmation
  CONFIRMED     // Admin confirmed the order
  PROCESSING    // Order is being prepared
  SHIPPED       // Order is in transit / out for delivery
  DELIVERED     // Order delivered to buyer
  CANCELLED     // Order cancelled
}

// Notification types
enum NotificationType {
  NEW_REQUEST             // Legacy
  NEW_OFFER               // Legacy
  OFFER_ACCEPTED          // Legacy
  OFFER_REJECTED          // Legacy
  ORDER_UPDATE            // Order status changed
  NEW_ORDER               // New order placed (for admin)
  ORDER_STATUS_CHANGE     // Order status changed (for buyer)
  SYSTEM                  // System notifications
  LOYALTY_POINTS_EARNED   // User earned loyalty points
  LOYALTY_REWARD_REDEEMED // User redeemed a reward
  LOYALTY_CAMPAIGN_COMPLETE // User completed a campaign
  LOYALTY_REFERRAL_SUCCESS  // Referral success notification
}

// Product categories - Legacy enum (kept for old Request model)
enum ProductCategory {
  SUGAR
  RICE
  CANDY_SNACKS
  DAIRY
  BEVERAGES
  CANNED_GOODS
  COOKING_OIL
  FLOUR_GRAINS
  SPICES
  CLEANING
  PERSONAL_CARE
  OTHER
}

// Unit of measurement
enum Unit {
  KG        // Kilogram
  GRAM      // Gram
  LITER     // Liter
  PIECE     // Individual piece
  PACK      // Package
  BOX       // Box
  CARTON    // Carton
  DOZEN     // 12 pieces
  PALLET    // Pallet
}

// Device platform for push notifications
enum Platform {
  IOS
  ANDROID
}

// Loyalty transaction types
enum LoyaltyTransactionType {
  EARN_ORDER                // Points earned from delivered order
  EARN_WELCOME              // Welcome bonus points
  EARN_REFERRAL_INVITER     // Points for inviting someone
  EARN_REFERRAL_INVITEE     // Points for being invited
  EARN_CAMPAIGN             // Points from campaign completion
  REDEEM                    // Points redeemed for reward
  MANUAL_ADD                // Admin manually added points
  MANUAL_REMOVE             // Admin manually removed points
  EXPIRED                   // Points expired
}

// Reward types
enum RewardType {
  FIXED_DISCOUNT        // Fixed amount discount (e.g., 10 JOD off)
  PERCENTAGE_DISCOUNT   // Percentage discount (e.g., 15% off)
  FREE_DELIVERY         // Free delivery
  CUSTOM                // Custom reward
}

// Campaign goal types
enum CampaignGoalType {
  SPEND_AMOUNT          // Spend X JOD
  ORDER_COUNT           // Place X orders
}

// Campaign status
enum CampaignStatus {
  DRAFT                 // Not yet published
  ACTIVE                // Currently running
  PAUSED                // Temporarily paused
  ENDED                 // Finished
}

// Collection types for virtual product groupings
enum CollectionType {
  MANUAL                // Manually curated by admin
  OFFERS                // Products with discounts/promotions
  FEATURED              // Homepage featured products
}

// ============================================
// CORE MODELS
// ============================================

model User {
  id            String    @id @default(cuid())
  phone         String    @unique  // رقم الهاتف كمعرّف فريد (07xxxxxxxx)
  email         String?   @unique  // اختياري
  passwordHash  String
  username      String    // اسم المستخدم (بدلاً من name)
  role          UserRole
  
  // Business details
  storeName     String?   // اسم البقالة/المتجر (بدلاً من businessName)
  businessAddress String?
  city          String?
  
  // Structured location
  cityId        String?
  cityRef       City?     @relation(fields: [cityId], references: [id])
  areaId        String?
  areaRef       Area?     @relation(fields: [areaId], references: [id])
  latitude      Float?
  longitude     Float?
  address       String?
  
  // For suppliers: areas they can deliver to
  deliveryAreas String[]
  
  // Verification
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations - Legacy RFQ
  requests      Request[]       @relation("BuyerRequests")
  offers        Offer[]         @relation("SupplierOffers")
  
  // Relations - New e-commerce
  buyerOrders   Order[]         @relation("BuyerOrders")
  supplierOrders Order[]        @relation("SupplierOrders")
  notifications Notification[]
  cartItems     CartItem[]
  deviceTokens  DeviceToken[]   // Multiple devices per user
  discountCodeUsages DiscountCodeUsage[]
  
  // Relations - Loyalty system
  loyaltyBalance         LoyaltyBalance?
  loyaltyTransactions    LoyaltyTransaction[]
  referral               UserReferral?
  referredUsers          UserReferral[]  @relation("ReferredBy")
  redeemedRewards        RedeemedReward[]
  campaignProgress       UserCampaignProgress[]
  loyaltyAuditLogs       LoyaltyAuditLog[]  @relation("AdminLoyaltyActions")
  targetedLoyaltyAudits  LoyaltyAuditLog[]  @relation("TargetUserLoyaltyActions")
  
  @@index([role])
  @@index([city])
  @@index([cityId])
  @@index([areaId])
}

// Purchase Request (RFQ - Request for Quotation)
model Request {
  id            String        @id @default(cuid())
  
  // Request details
  title         String
  description   String?
  category      ProductCategory
  
  // Product specifications
  productName   String
  quantity      Float
  unit          Unit
  
  // Optional specifications
  brand         String?       // Preferred brand (if any)
  specifications String?      // Additional specs (e.g., "organic", "imported")
  
  // Delivery requirements
  deliveryCity  String
  deliveryAddress String?
  deliveryDeadline DateTime?
  
  // Budget
  maxBudget     Float?        // Maximum budget (optional)
  
  // Status & timing
  status        RequestStatus @default(OPEN)
  expiresAt     DateTime      // When the request stops accepting offers
  
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  
  // Relations
  buyerId       String
  buyer         User          @relation("BuyerRequests", fields: [buyerId], references: [id], onDelete: Cascade)
  offers        Offer[]
  order         Order?
  
  @@index([status])
  @@index([category])
  @@index([deliveryCity])
  @@index([buyerId])
  @@index([createdAt])
}

// Supplier's Offer on a Request
model Offer {
  id            String      @id @default(cuid())
  
  // Pricing
  pricePerUnit  Float
  totalPrice    Float
  quantity      Float       // Quantity supplier can provide
  unit          Unit
  
  // Delivery terms
  deliveryDays  Int         // Days needed for delivery
  deliveryNotes String?
  
  // Offer details
  notes         String?     // Additional notes from supplier
  validUntil    DateTime    // Offer validity period
  
  // Status
  status        OfferStatus @default(PENDING)
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations
  requestId     String
  request       Request     @relation(fields: [requestId], references: [id], onDelete: Cascade)
  
  supplierId    String
  supplier      User        @relation("SupplierOffers", fields: [supplierId], references: [id], onDelete: Cascade)
  
  order         Order?
  
  @@unique([requestId, supplierId]) // One offer per supplier per request
  @@index([status])
  @@index([supplierId])
  @@index([requestId])
}

// Order (created when an offer is accepted - Legacy, or from cart - New)
model Order {
  id            String      @id @default(cuid())
  orderNumber   String      @unique @default(cuid())
  
  // Order total
  totalPrice    Float
  deliveryFee   Float     @default(0)  // Separate delivery fee for loyalty calculations
  
  // Delivery
  deliveryAddress String
  deliveryAddressDetails String?
  deliveryCity    String
  deliveryCityId  String?
  deliveryAreaId  String?
  expectedDelivery DateTime?
  actualDelivery   DateTime?
  
  // Delivery promotion used
  deliveryPromotionId String?
  deliveryPromotion   DeliveryPromotion? @relation(fields: [deliveryPromotionId], references: [id])
  
  // Status
  status        OrderStatus @default(PENDING)
  statusHistory Json        @default("[]") // Array of {status, timestamp, note}
  
  // Notes
  buyerNotes    String?
  adminNotes    String?
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  
  // Relations - Buyer
  buyerId       String
  buyer         User        @relation("BuyerOrders", fields: [buyerId], references: [id])
  
  // Relations - Supplier (admin assigns, optional)
  supplierId    String?
  supplier      User?       @relation("SupplierOrders", fields: [supplierId], references: [id])
  
  // Relations - Order items
  items         OrderItem[]
  
  // Legacy relations (nullable for new orders)
  requestId     String?     @unique
  request       Request?    @relation(fields: [requestId], references: [id])
  offerId       String?     @unique
  offer         Offer?      @relation(fields: [offerId], references: [id])
  
  // Loyalty system
  loyaltyPointsEarned  Int?     // Points earned from this order (when delivered)
  redeemedRewardId     String?  // Redeemed reward applied to this order
  redeemedReward       RedeemedReward? @relation(fields: [redeemedRewardId], references: [id])
  
  @@index([status])
  @@index([buyerId])
  @@index([supplierId])
  @@index([createdAt])
}

// Order item (snapshot of product at time of order)
model OrderItem {
  id            String   @id @default(cuid())
  
  // Product snapshot
  productId     String?  // Optional for RFQ-based orders
  productName   String
  productNameEn String?
  productImage  String?
  
  // Variant snapshot
  variantSize   String?    // e.g., "2 كيلو"
  variantSizeEn String?    // e.g., "2kg"
  
  // Option snapshot (flavor/color selected at order time)
  variantOptionName   String?  // e.g., "تفاح"
  variantOptionNameEn String?  // e.g., "Apple"
  
  // Unit snapshot (captures which unit was selected at order time)
  unitLabel     String?    // e.g., "كرتونة (36 قطعة)"
  unitLabelEn   String?    // e.g., "Carton (36 pieces)"
  piecesPerUnit Int       @default(1) // How many pieces in the selected unit
  
  // Pricing
  quantity      Int
  unit          String    // Unit type code snapshot (e.g., "PIECE", "DOZEN", or admin-created codes)
  pricePerUnit  Float     // Actual price paid (after discount if any)
  totalPrice    Float     // pricePerUnit × quantity
  
  // Discount snapshot (captured at order time)
  originalPricePerUnit Float?   // Price before campaign discount (null = no discount)
  discountPercent      Float?   // Campaign discount % applied (null = no discount)
  
  // Buyer note for this item
  note          String?  // Optional note from buyer about this specific item
  
  // Relations
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product? @relation(fields: [productId], references: [id])
  
  @@index([orderId])
  @@index([productId])
}

// ============================================
// E-COMMERCE MODELS
// ============================================

// Product category (flexible, admin-managed, hierarchical)
model Category {
  id          String    @id @default(cuid())
  name        String    // Arabic name
  nameEn      String?   // English name
  slug        String    @unique // URL-safe identifier
  image       String?   // Category image path
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  
  // Hierarchy fields
  parentId    String?   // Self-referencing FK for nested categories
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  depth       Int       @default(0)  // Cached depth level (root=0)
  path        String    @default("") // Materialized path for efficient descendant queries
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  products    Product[]            // Legacy direct FK (primary category shortcut)
  productCategories ProductOnCategory[]  // Many-to-many product classification
  tags        Tag[]                // Filter tabs within this category
  discountCampaigns DiscountCampaign[] // Discount campaigns targeting this category
  
  @@index([sortOrder])
  @@index([isActive])
  @@index([parentId])
  @@index([path])
}

// Brand (admin-managed, products grouped by brand)
model Brand {
  id            String    @id @default(cuid())
  name          String    // Arabic name
  nameEn        String?   // English name
  slug          String    @unique
  logo          String?   // Brand logo image URL
  description   String?   // Arabic description
  descriptionEn String?   // English description
  sortOrder     Int       @default(0)
  isActive      Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations
  products      Product[]
  
  @@index([isActive])
  @@index([sortOrder])
  @@index([slug])
}

// Many-to-many: Product belongs to multiple categories
model ProductOnCategory {
  productId   String
  categoryId  String
  isPrimary   Boolean   @default(false) // One primary per product (for display/URL)
  sortOrder   Int       @default(0)     // Product position within this category
  
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  @@id([productId, categoryId])
  @@index([categoryId])
  @@index([productId])
  @@index([isPrimary])
}

// Collection (virtual product grouping: Offers, Best Sellers, Featured, etc.)
model Collection {
  id              String           @id @default(cuid())
  name            String           // Arabic name
  nameEn          String?          // English name
  slug            String           @unique
  description     String?          // Arabic description
  descriptionEn   String?          // English description
  image           String?          // Collection cover image
  type            CollectionType   @default(MANUAL)
  sortOrder       Int              @default(0)
  isActive        Boolean          @default(true)
  showOnHome      Boolean          @default(false) // Display on mobile home screen
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Relations
  products        CollectionProduct[]
  discountCampaigns DiscountCampaign[] // Discount campaigns targeting this collection
  
  @@index([isActive])
  @@index([showOnHome])
  @@index([sortOrder])
  @@index([slug])
}

// Junction: Product in a Collection
model CollectionProduct {
  collectionId  String
  productId     String
  sortOrder     Int        @default(0)  // Product position within collection
  
  collection    Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product       Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@id([collectionId, productId])
  @@index([productId])
}

// Tag (admin-controlled filter tabs within a category)
model Tag {
  id          String   @id @default(cuid())
  name        String   // Arabic: "مشروبات شعير"
  nameEn      String?  // English: "Malt Drinks"
  slug        String   // Normalized slug (unique within category)
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  
  // Scoped to a category
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  products    ProductTag[]
  
  @@unique([categoryId, slug]) // Unique slug per category
  @@index([categoryId])
  @@index([isActive])
  @@index([sortOrder])
}

// Junction: Product tagged with a Tag
model ProductTag {
  productId String
  tagId     String
  
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([productId, tagId])
  @@index([tagId])
}

// Supplier (managed by admin, provides products)
model Supplier {
  id          String    @id @default(cuid())
  name        String    // Arabic name
  nameEn      String?   // English name
  phone       String?
  email       String?
  address     String?
  city        String?
  isDefault   Boolean   @default(false) // Default supplier for new products
  isActive    Boolean   @default(true)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  // Relations
  products    Product[]
  
  @@index([isActive])
  @@index([isDefault])
}

// Product in the catalog
model Product {
  id              String    @id @default(cuid())
  
  // Basic info
  name            String    // Arabic name
  nameEn          String?   // English name
  description     String?   // Arabic description
  descriptionEn   String?   // English description
  keywords        String?   // Admin-entered search synonyms (dialects, plurals, common misspellings)
  searchText      String    @default("") // Normalized text for search: names + brand + variant sizes + options + keywords

  // Media
  image           String?   // Main product image path
  images          String[]  // Additional images
  
  // Primary classification (denormalized shortcut — synced with ProductCategory isPrimary=true)
  categoryId      String
  category        Category  @relation(fields: [categoryId], references: [id])
  
  // Brand (optional)
  brandId         String?
  brand           Brand?    @relation(fields: [brandId], references: [id])
  
  // Supplier
  supplierId      String?
  supplier        Supplier? @relation(fields: [supplierId], references: [id])
  
  // Status
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  variants        ProductVariant[]      // Multiple size variants (e.g., 2kg, 4kg)
  orderItems      OrderItem[]
  categories      ProductOnCategory[]   // Many-to-many category classification
  collections     CollectionProduct[]   // Virtual groupings (Offers, Best Sellers, etc.)
  tags            ProductTag[]          // Filter tags
  discountCampaigns DiscountCampaignProduct[] // Discount campaigns targeting this product
  
  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
  @@index([isActive])
  @@index([sortOrder])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Product size variant (e.g., 2kg, 4kg of the same product)
model ProductVariant {
  id              String    @id @default(cuid())
  
  // Size info
  size            String    // Arabic size label: "2 كيلو", "4 كيلو"
  sizeEn          String?   // English size label: "2kg", "4kg"
  image           String?   // Optional image URL (Cloudinary) for this variant/size
  
  // Inventory (per variant — used when variant has NO options)
  sku             String?   @unique
  barcode         String?
  stock           Int       @default(0)
  minOrderQuantity Int      @default(1)
  
  // Status
  isDefault       Boolean   @default(false) // Default variant shown in product card
  isActive        Boolean   @default(true)
  sortOrder       Int       @default(0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  units           ProductUnit[]  // Selling units for this variant (piece, dozen, carton...)
  options         VariantOption[]  // Flavor/color options (when present, stock tracked per option)
  cartItems       CartItem[]
  
  @@index([productId])
}

// Variant option (e.g., flavor, color — stock tracked per option)
// When a variant has options, individual stock moves here; variant.stock becomes computed sum
model VariantOption {
  id            String   @id @default(cuid())
  name          String   // Arabic: "تفاح", "برتقال"
  nameEn        String?  // English: "Apple", "Orange"
  image         String?  // Optional image URL (Cloudinary) for this specific option
  stock         Int      @default(0)
  sku           String?  @unique
  barcode       String?
  priceOverride Float?   // Nullable: if set, overrides ProductUnit price for this option
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // Relations
  variantId     String
  variant       ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  
  @@index([variantId])
  @@index([isActive])
}

// Admin-managed unit type (drives the "نوع الوحدة" dropdown in product forms)
model UnitType {
  id            String   @id @default(cuid())
  code          String   @unique // Stable code stored on ProductUnit.unit (e.g., "PIECE", "DOZEN", or generated)
  name          String   // Arabic name: "حبة", "دزينة", "كرتونة"
  nameEn        String?  // English name: "Piece", "Dozen", "Carton"
  defaultPieces Int      @default(1) // Default pieces-per-unit suggested when selected
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive])
}

// Product selling unit (e.g., piece, dozen, carton with different prices)
model ProductUnit {
  id              String    @id @default(cuid())

  unit            String    // Unit type code (matches UnitType.code, e.g., "PIECE", "DOZEN")
  label           String    // Arabic label: "قطعة", "دزينة", "كرتونة"
  labelEn         String?   // English label: "Piece", "Dozen", "Carton"
  piecesPerUnit   Int       @default(1)  // 1 for piece, 12 for dozen, 36 for carton
  price           Float     // Price for this unit (JOD)
  wholesalePrice  Float?    // Wholesale/cost price for profit calculation (JOD)
  compareAtPrice  Float?    // Original price before discount for this unit
  isDefault       Boolean   @default(false) // Default unit shown in product card
  sortOrder       Int       @default(0)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  variantId       String
  variant         ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  cartItems       CartItem[]
  
  @@unique([variantId, unit]) // No duplicate unit per variant
  @@index([variantId])
}

// Shopping cart item (server-side cart for mobile app)
model CartItem {
  id          String   @id @default(cuid())
  quantity    Int      @default(1)
  note        String?  // Optional note from buyer about this item
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relations
  buyerId     String
  buyer       User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  
  // Variant (required - specifies which size variant)
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  
  // Selected unit (optional - if null, uses variant default unit/price)
  productUnitId String?
  productUnit   ProductUnit? @relation(fields: [productUnitId], references: [id])
  
  // Selected option (optional - e.g., flavor choice within a variant)
  variantOptionId String?
  variantOption   VariantOption? @relation(fields: [variantOptionId], references: [id])
  
  @@unique([buyerId, variantId, productUnitId, variantOptionId]) // One cart entry per variant+unit+option per buyer
  @@index([buyerId])
}

// Notifications
model Notification {
  id            String           @id @default(cuid())
  type          NotificationType
  title         String
  message       String
  
  // Link to related entity
  linkUrl       String?
  imageUrl      String?          // Optional image for push notifications
  data          Json?            // Custom payload data for deep linking
  
  // Push status
  isSent        Boolean          @default(false)  // Whether push was actually sent
  isGlobal      Boolean          @default(false)  // Broadcast to all users
  
  // Read status
  isRead        Boolean          @default(false)
  
  createdAt     DateTime         @default(now())
  
  // Relations
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, isRead])
  @@index([createdAt])
  @@index([isSent])
}

// Notices/Announcements - Rotating banner on home screen
model Notice {
  id              String    @id @default(cuid())
  
  // Content
  text            String    @db.VarChar(255)  // Max 255 chars
  
  // Styling
  backgroundColor String    @default("#f97316")  // Hex color format (#RRGGBB)
  textColor       String    @default("#FFFFFF")  // Hex color format (#RRGGBB)
  
  // Display settings
  isMobileOnly    Boolean   @default(true)   // Show only in mobile app, not on website
  
  // Status (soft delete)
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  @@index([isActive])
  @@index([isMobileOnly])
  @@index([createdAt])
}

// Device tokens for push notifications
// Token represents a device/app installation, NOT an authenticated session.
// userId is nullable — anonymous devices can still receive broadcast/marketing push.
model DeviceToken {
  id            String    @id @default(cuid())
  token         String    @unique  // FCM or Expo token
  platform      Platform            // IOS or ANDROID
  
  isActive      Boolean   @default(true)
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  // Relations — userId is optional (null = anonymous/logged-out device)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  @@index([userId])
  @@index([isActive])
}

// ============================================
// LOCATION MODELS
// ============================================

// Jordan cities
model City {
  id        String   @id @default(cuid())
  name      String   // Arabic name
  nameEn    String   // English name
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  areas         Area[]
  users         User[]
  deliveryZone  DeliveryZone?

  @@index([sortOrder])
}

// Areas within a city
model Area {
  id        String   @id @default(cuid())
  name      String   // Arabic name
  nameEn    String   // English name
  sortOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  cityId    String
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)
  users     User[]

  @@index([cityId])
  @@index([sortOrder])
}

// ============================================
// DISCOUNT CODE (COUPON) MODELS
// ============================================

// Discount codes managed by admin
model DiscountCode {
  id              String    @id @default(cuid())
  
  // Core fields
  code            String    @unique  // Stored uppercase (e.g. ISTKLAL2026, SBA)
  discountPercent Float              // Percentage (e.g. 15 = 15%)
  
  // Usage rules
  isSingleUse     Boolean   @default(false)  // Each user can use only once
  maxUsage        Int?               // Max total uses across all users (null = unlimited)
  minOrderAmount  Float?             // Min order total for code to be valid (JOD)
  
  // Date range
  startDate       DateTime?          // When code becomes active (null = immediately)
  endDate         DateTime?          // When code expires (null = no expiry)
  
  // Status
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Relations
  usages          DiscountCodeUsage[]
  
  @@index([code])
  @@index([isActive])
}

// Tracks each use of a discount code
model DiscountCodeUsage {
  id              String    @id @default(cuid())
  
  discountAmount  Float              // Actual JOD saved
  orderTotal      Float              // Order total before discount
  
  createdAt       DateTime  @default(now())
  
  // Relations
  discountCodeId  String
  discountCode    DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  orderId         String?            // Linked after order is placed
  
  @@index([discountCodeId])
  @@index([userId])
  @@index([discountCodeId, userId])
}

// ============================================
// ACCOUNT DELETION (PRIVACY + ABUSE PREVENTION)
// ============================================

// Preserves single-use coupon usage by deleted users so the coupon cannot be
// reused after deleting and re-registering with the same phone number.
// No personal data is stored — only a salted hash of the normalized phone.
model DeletedUserCouponUsage {
  id              String    @id @default(cuid())
  
  phoneNumberHash String              // HMAC-SHA256 of normalized phone (E.164)
  discountCodeId  String              // The single-use code that was consumed
  usedAt          DateTime  @default(now())
  
  @@unique([phoneNumberHash, discountCodeId])
  @@index([phoneNumberHash])
}

// Tracks non-personal flags for deleted accounts so one-time grants
// (welcome bonus, referral invitee reward) cannot be re-claimed after
// deleting and re-registering with the same phone number.
model DeletedAccountRecord {
  id                   String    @id @default(cuid())
  
  phoneNumberHash      String    @unique  // HMAC-SHA256 of normalized phone (E.164)
  welcomeBonusReceived Boolean   @default(false)
  referralInviteeUsed  Boolean   @default(false)
  deletedAt            DateTime  @default(now())
  
  @@index([phoneNumberHash])
}

// ============================================
// LOYALTY & REWARDS SYSTEM
// ============================================

// Loyalty system configuration (singleton table - one row)
model LoyaltyConfig {
  id                  String    @id @default(cuid())
  
  // Enable/disable entire system
  isEnabled           Boolean   @default(true)
  
  // Points calculation
  pointsPerJod        Float     @default(10)      // 1 JOD = X points
  calculationBase     Float     @default(1)       // Calculate points per X JOD
  minOrderValue       Float?                      // Min order value to earn points
  excludeDeliveryFees Boolean   @default(true)    // Exclude delivery from calculations
  roundingMode        String    @default("FLOOR") // FLOOR, CEIL, ROUND
  
  updatedAt           DateTime  @updatedAt
}

// User loyalty balance (one per user)
model LoyaltyBalance {
  id              String    @id @default(cuid())
  
  // Balance tracking
  totalEarned     Int       @default(0)  // Total points ever earned
  totalRedeemed   Int       @default(0)  // Total points ever redeemed
  currentBalance  Int       @default(0)  // Available points
  
  updatedAt       DateTime  @updatedAt
  
  // Relations
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([currentBalance])
}

// Loyalty transaction log (immutable audit trail)
model LoyaltyTransaction {
  id              String                  @id @default(cuid())
  
  type            LoyaltyTransactionType
  points          Int                     // Positive for earn, negative for redeem
  description     String
  descriptionEn   String?
  // Reference to related entity (order, campaign, etc.)
  referenceId     String?
  referenceType   String?                 // "ORDER", "CAMPAIGN", "REFERRAL", "MANUAL"
  
  // Additional data
  metadata        Json?                   // Flexible data storage
  
  createdAt       DateTime                @default(now())
  
  // Relations
  userId          String
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([userId, createdAt])
  @@index([type])
  @@index([referenceId])
}

// Welcome bonus configuration (singleton)
model WelcomeBonusConfig {
  id              String    @id @default(cuid())
  
  isEnabled       Boolean   @default(true)
  points          Int       @default(100)
  trigger         String    @default("SIGNUP") // "SIGNUP" or "FIRST_DELIVERED_ORDER"
  
  updatedAt       DateTime  @updatedAt
}

// Referral system configuration (singleton)
model ReferralConfig {
  id              String    @id @default(cuid())
  
  isEnabled       Boolean   @default(true)
  inviterPoints   Int       @default(50)   // Points for person who invited
  inviteePoints   Int       @default(50)   // Points for person who signed up
  trigger         String    @default("FIRST_DELIVERED_ORDER") // "SIGNUP" or "FIRST_DELIVERED_ORDER"
  
  updatedAt       DateTime  @updatedAt
}

// User referral tracking
model UserReferral {
  id                    String    @id @default(cuid())
  
  referralCode          String    @unique  // Unique code for this user
  
  // Tracking
  referralRewardClaimed Boolean   @default(false)  // Invitee claimed their reward
  inviterRewardClaimed  Boolean   @default(false)  // Inviter claimed their reward
  
  createdAt             DateTime  @default(now())
  
  // Relations
  userId                String    @unique
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Who referred this user (nullable - not everyone is referred)
  referredByUserId      String?
  referredBy            User?     @relation("ReferredBy", fields: [referredByUserId], references: [id])
  
  @@index([referralCode])
  @@index([referredByUserId])
}

// Loyalty rewards catalog (admin-created)
model LoyaltyReward {
  id              String      @id @default(cuid())
  
  // Basic info
  name            String
  nameEn          String?
  description     String?
  descriptionEn   String?
  
  // Redemption
  pointsCost      Int
  rewardType      RewardType
  discountValue   Float       // JOD for fixed, percentage for percentage discount
  
  // Constraints
  maxDiscountCap  Float?      // Max discount amount for percentage discounts
  minOrderValue   Float?      // Min order value to use this reward
  expirationDays  Int         @default(30)  // Days until coupon expires after redemption
  usageLimit      Int?        // Max total redemptions (null = unlimited)
  
  // Status
  totalRedeemed   Int         @default(0)
  isActive        Boolean     @default(true)
  sortOrder       Int         @default(0)
  
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  // Relations
  redemptions     RedeemedReward[]
  
  @@index([isActive, sortOrder])
  @@index([pointsCost])
}

// Redeemed rewards (issued coupons)
model RedeemedReward {
  id              String      @id @default(cuid())
  
  couponCode      String      @unique  // Unique generated code
  
  // Snapshot of reward at redemption time
  discountValue   Float
  rewardType      RewardType
  minOrderValue   Float?
  maxDiscountCap  Float?
  
  // Status
  expiresAt       DateTime
  isUsed          Boolean     @default(false)
  usedAt          DateTime?
  
  createdAt       DateTime    @default(now())
  
  // Relations
  userId          String
  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  rewardId        String
  reward          LoyaltyReward @relation(fields: [rewardId], references: [id])
  
  orderId         String?     // Order where coupon was used
  orders          Order[]     // Orders that used this reward
  
  @@index([userId, isUsed])
  @@index([couponCode])
  @@index([expiresAt])
}

// Loyalty campaigns (progress/goal challenges)
model LoyaltyCampaign {
  id              String          @id @default(cuid())
  
  // Basic info
  name            String
  nameEn          String?
  description     String?
  descriptionEn   String?
  
  // Goal
  goalType        CampaignGoalType
  targetValue     Float           // Amount (JOD) or count (orders)
  
  // Reward
  rewardType      RewardType
  rewardValue     Float
  
  // Duration
  startDate       DateTime
  endDate         DateTime
  
  // Status
  status          CampaignStatus  @default(DRAFT)
  isActive        Boolean         @default(true)
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  userProgress    UserCampaignProgress[]
  
  @@index([status, isActive])
  @@index([startDate, endDate])
}

// User progress in campaigns
model UserCampaignProgress {
  id              String          @id @default(cuid())
  
  currentValue    Float           @default(0)  // Current spend or order count
  isCompleted     Boolean         @default(false)
  rewardClaimed   Boolean         @default(false)
  completedAt     DateTime?
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  campaignId      String
  campaign        LoyaltyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  @@unique([userId, campaignId])
  @@index([userId, isCompleted])
  @@index([campaignId, isCompleted])
}

// Admin actions audit log
model LoyaltyAuditLog {
  id              String    @id @default(cuid())
  
  action          String    // "ADD_POINTS", "REMOVE_POINTS", "LOCK_ACCOUNT", etc.
  details         Json      // Flexible data storage
  
  createdAt       DateTime  @default(now())
  
  // Relations
  adminId         String
  admin           User      @relation("AdminLoyaltyActions", fields: [adminId], references: [id])
  
  targetUserId    String?
  targetUser      User?     @relation("TargetUserLoyaltyActions", fields: [targetUserId], references: [id])
  
  @@index([adminId, createdAt])
  @@index([targetUserId])
  @@index([action])
}

// OTP verification sessions (WhatsApp)
model OtpSession {
  id              String    @id @default(cuid())
  phone           String    // E.164 format (+962XXXXXXXXX)
  code            String    // 6-digit OTP code (hashed)
  status          String    @default("pending") // pending, verified, expired, max_attempts
  attempts        Int       @default(0)
  messageId       String?   // WhatsApp message ID
  expiresAt       DateTime
  createdAt       DateTime  @default(now())
  verifiedAt      DateTime?

  @@index([phone, status])
  @@index([expiresAt])
}

// OTP rate limiting (persisted)
model OtpRateLimit {
  id              String    @id @default(cuid())
  phone           String    @unique // E.164 format
  attempts        Int       @default(1)
  windowStart     DateTime  @default(now())
  lastRequest     DateTime  @default(now())

  @@index([phone])
}

// ============================================
// DELIVERY MANAGEMENT SYSTEM
// ============================================

enum DeliveryPromotionType {
  FREE_DELIVERY   // Remove delivery fee entirely
  REDUCED_FEE     // Subtract a fixed amount from fee
  FLAT_RATE       // Override fee with a flat rate
}

enum DeliveryScope {
  ALL_CITIES       // Applies to all cities
  SPECIFIC_CITIES  // Applies to selected cities only
}

// Global delivery configuration (singleton)
model DeliveryConfig {
  id                     String        @id @default(cuid())
  isEnabled              Boolean       @default(true)       // Global kill switch
  defaultFee             Float         @default(3.0)        // Fallback fee (JOD)
  freeDeliveryEnabled    Boolean       @default(false)      // Is free delivery threshold active?
  freeDeliveryThreshold  Float?                             // Orders above this = free delivery
  freeDeliveryScope      DeliveryScope @default(ALL_CITIES) // Where free delivery applies
  minOrderAmount         Float?                             // Min order to allow checkout (null = no min)
  estimatedDeliveryDays  Int           @default(2)          // Default estimated days
  updatedAt              DateTime      @updatedAt
  createdAt              DateTime      @default(now())
}

// Per-city delivery zone pricing
model DeliveryZone {
  id                    String    @id @default(cuid())
  cityId                String    @unique
  city                  City      @relation(fields: [cityId], references: [id], onDelete: Cascade)
  isActive              Boolean   @default(true)  // Can disable delivery to this city
  isVisible             Boolean   @default(true)  // Hide from mobile UI temporarily
  fee                   Float     @default(3.0)   // Delivery fee for this city (JOD)
  freeDeliveryThreshold Float?                    // Override global threshold for this city
  freeDeliveryEnabled   Boolean?                  // Override global free delivery flag (null = use global)
  estimatedDays         Int?                      // Override global estimated days
  sortOrder             Int       @default(0)
  notes                 String?                   // Admin-only notes
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([isActive, isVisible])
  @@index([sortOrder])
}

// Time-limited delivery promotions (campaigns)
model DeliveryPromotion {
  id              String                @id @default(cuid())
  name            String                // Arabic name
  nameEn          String?               // English name
  type            DeliveryPromotionType // FREE_DELIVERY | REDUCED_FEE | FLAT_RATE
  value           Float         @default(0) // Discount amount or flat rate value
  scope           DeliveryScope @default(ALL_CITIES)
  cityIds         String[]      @default([]) // Applicable city IDs when scope = SPECIFIC_CITIES
  minOrderAmount  Float?                // Min order total for promotion to apply
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean       @default(true)
  usageLimit      Int?                  // Max total uses (null = unlimited)
  usageCount      Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Orders that used this promotion
  orders          Order[]

  @@index([isActive, startDate, endDate])
}

// ============================================
// DISCOUNT CAMPAIGN SYSTEM
// ============================================

// Scope of a discount campaign
enum DiscountCampaignScope {
  ALL_PRODUCTS          // Applies to every product
  SPECIFIC_PRODUCTS     // Applies to selected products only
  COLLECTION            // Applies to all products in a collection
  CATEGORY              // Applies to all products in a category
}

// Discount campaign status
enum DiscountCampaignStatus {
  ACTIVE                // Currently applying
  PAUSED                // Temporarily stopped
  EXPIRED               // End date passed (auto-set by system)
  SCHEDULED             // Start date in future
}

// Discount Campaign (admin-managed price reductions)
model DiscountCampaign {
  id              String                   @id @default(cuid())
  
  // Basic info
  name            String                   // Arabic name: "خصم نهاية الأسبوع"
  nameEn          String?                  // English name: "Weekend Discount"
  
  // Discount settings
  discountPercent Float                    // e.g., 5.0 = 5%
  
  // Scheduling
  startDate       DateTime                 // When discount begins
  endDate         DateTime?                // When discount ends (null = open-ended)
  
  // Scope: what does this campaign apply to?
  scope           DiscountCampaignScope    @default(SPECIFIC_PRODUCTS)
  
  // When scope = COLLECTION, reference the collection
  collectionId    String?
  collection      Collection?              @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  
  // When scope = CATEGORY, reference the category
  categoryId      String?
  category        Category?                @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  
  // Status
  status          DiscountCampaignStatus   @default(ACTIVE)
  
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  
  // Relations
  products        DiscountCampaignProduct[] // When scope = SPECIFIC_PRODUCTS
  
  @@index([status, startDate, endDate])
  @@index([scope])
  @@index([collectionId])
  @@index([categoryId])
}

// Junction table: Products in a specific discount campaign
model DiscountCampaignProduct {
  campaignId  String
  productId   String
  
  campaign    DiscountCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  @@id([campaignId, productId])
  @@index([productId])
}
